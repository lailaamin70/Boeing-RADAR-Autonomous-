      "score_threshold": 0.5,
      "score_comparison": "prediction score >= score threshold",
      "match_distance_m": 2.0,
      "matching_algorithm": "Within each sample and class, predictions are ordered by descending score with original prediction index as the tie-break. Each prediction is matched to the nearest still-unmatched GT; GT index breaks equal-distance ties; distance must be strictly less than match_distance_m."
